{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDirs": ["./src", "../src"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@app/*": ["../src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*", "../src/services/emotionService.ts", "../src/utils/contextBuilder.ts"],
  "exclude": ["node_modules", "dist"]
}
